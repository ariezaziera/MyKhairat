# Turso SQLite. Use a local file for development, or a Turso URL in production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Required in production. Use a long random string.
AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this app. Used for Google OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Email/password login works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true on the first production boot if you want the demo families loaded.
SEED_DEMO=false
