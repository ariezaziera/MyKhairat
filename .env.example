# Gunakan file untuk development berasingan; Turso untuk production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Kunci sesi dan kunci IC. Simpan kunci data yang sama jika database dikongsi.
AUTH_SECRET=replace-with-a-long-random-string
DATA_ENCRYPTION_KEY=replace-with-a-separate-stable-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Aktifkan hanya pada database demo yang berasingan.
SEED_DEMO=false

# Provision owner hanya jika email belum wujud; bukan reset automatik.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Job backup harian Vercel. Jangan dedahkan sebagai NEXT_PUBLIC.
CRON_SECRET=replace-with-a-long-random-string
BACKUP_PASSPHRASE=replace-with-a-separate-backup-passphrase
